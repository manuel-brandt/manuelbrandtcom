---
import { NAV, LISTS, SOCIALS, SITE } from '../site.config';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap-wide header-inner">
    <a href="/" class="brand">{SITE.name}</a>
    <nav aria-label="Main">
      <ul class="nav">
        {NAV.map((n) => (
          <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
        <li class="dropdown">
          <details>
            <summary>My Lists</summary>
            <ul>
              {LISTS.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.label}</a></li>)}
            </ul>
          </details>
        </li>
      </ul>
    </nav>
    <ul class="socials">
      {SOCIALS.map((s) => (
        <li><a href={s.href} target="_blank" rel="noopener me" aria-label={s.label} class={`social social-${s.icon}`}><Icon name={s.icon} /></a></li>
      ))}
    </ul>
  </div>
</header>
<script>
  // close the "My Lists" dropdown when clicking elsewhere
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('.dropdown details[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
</script>
