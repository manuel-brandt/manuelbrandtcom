---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { CATEGORIES } from '../../content.config';
import { getPosts } from '../../lib/posts';

// a category page only exists while it has visible posts
export async function getStaticPaths() {
  const posts = await getPosts();
  return Object.keys(CATEGORIES)
    .filter((c) => posts.some((p) => p.data.category === c))
    .map((category) => ({ params: { category } }));
}
const category = Astro.params.category as keyof typeof CATEGORIES;
const allPosts = await getPosts();
const posts = allPosts.filter((p) => p.data.category === category);
const label = CATEGORIES[category];
---
<Base title={label} description={`All posts in ${label}.`} noindex={category === 'book-notes'}>
  <div class="wrap">
    <p><a href="/blog/">← All posts</a></p>
    <h1>{label}</h1>
    <ul class="chips">
      {Object.entries(CATEGORIES).filter(([slug]) => allPosts.some((p) => p.data.category === slug)).map(([slug, l]) => (
        <li><a href={`/category/${slug}/`} aria-current={slug === category ? 'page' : undefined}>{l}</a></li>
      ))}
    </ul>
    <h2 class="section-title">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</h2>
    {posts.length ? <PostList posts={posts} showCategory={false} /> : <p>Nothing here yet.</p>}
  </div>
</Base>
